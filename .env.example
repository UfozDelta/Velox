# Copy to .env and fill in. Never commit .env.

# KuCoin Futures API key (needs "General" + "Futures" permissions)
KuCoinAPI=
KuCoinSecret=
KuCoinPass=

# Safety limits (optional; defaults shown)
F3L_MAX_LEVERAGE=20          # orders above this leverage are refused
F3L_MAX_ORDER_USD=10000      # one command can't place more than this notional
F3L_CONFIRM_ABOVE_USD=1000   # ask "are you sure?" at or above this notional
F3L_DEFAULT_LEVERAGE=1       # used when you don't pass -l
